            "commandWindows": "cmd /c if exist \"\\Users\\erincpolat\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" \"\\Users\\erincpolat\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
            "timeout": 30,
